<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<link rel="icon" href="./fruit img/logo.png" type="image/png">
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>FreshFind | Vegetable Farm Market Directory</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">

<link rel="stylesheet" href="../navbar.css">
<link rel="stylesheet" href="../chat-widget.css">
<link rel="stylesheet" href="../bookmark-widget.css">
<style>
:root{
  /* Vegetable palette */
  --leaf:#2d5a2a;
  --basil:#4a7c3f;
  --kale:#1e4620;
  --herb:#6b9b5a;
  --lime:#8fbc4a;
  --spring:#a8d574;
  --cucumber:#c8e6a0;
  --celery:#d4e8b8;
  --zucchini:#5a8c4a;
  --sage:#eaf3dc;
  --cream:#f6f9ef;
  --dark:#1c2e18;
  --muted:#5a6b52;
  --card:#f9fcef;
}
*{box-sizing:border-box}
html{background:var(--cream)}
body{
  margin:0;
  font-family:Inter,Arial,sans-serif;
  background:transparent;
  color:var(--dark);
  overflow-x:hidden;
}
body.modal-open{overflow:hidden}

/* ---------- VIDEO BACKGROUND ---------- */
.video-bg{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.video-bg video{width:100%;height:100%;object-fit:cover;display:block}
.video-overlay{position:fixed;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(180deg,
    rgba(45,90,42,.22) 0%,
    rgba(107,155,90,.10) 25%,
    rgba(0,0,0,0)      48%,
    rgba(168,213,116,.12) 72%,
    rgba(45,90,42,.30) 100%);}
@media (prefers-reduced-motion: reduce){
  .video-bg{display:none}
  body{background:linear-gradient(135deg,#eaf3dc,#c8e6a0 40%,#d4e8b8 70%,#f6f9ef);background-attachment:fixed}
}

/* ---------- LAYOUT ---------- */
section.hero,.filters,main{position:relative;z-index:2}

.hero{
  padding:clamp(24px, 5vw, 60px) clamp(16px, 5vw, 7%) clamp(20px, 4vw, 40px);
  background:transparent;
}

.hero-inner{
  width:100%;
  max-width:min(820px, 100%);
  background:linear-gradient(145deg, rgba(250,253,242,.92), rgba(214,232,180,.88));
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  padding:clamp(20px, 4vw, 34px) clamp(18px, 4vw, 40px) clamp(18px, 3.5vw, 26px);
  border-radius:clamp(18px, 3vw, 28px);
  box-shadow:0 12px 40px rgba(45,90,42,.25), 0 0 0 1px rgba(143,188,74,.30) inset;
  border:1px solid rgba(255,255,255,.55);
  position:relative;
  box-sizing:border-box;
  overflow:hidden;
}

/* ============================================================
   SPRING PHYSICS HEADING — solid leafy green
   ============================================================ */
.label{
  display:block;
  font-family:'DM Mono', monospace;
  font-size:clamp(9px, 1.2vw, 10px);
  font-weight:300;
  letter-spacing:0.18em;
  text-transform:uppercase;
  color:#8a9678;
  margin-bottom:clamp(10px, 1.6vw, 20px);
}

.text{
  display:block;
  font-family:'Instrument Serif', Georgia, serif;
  font-size:clamp(26px, 7vw, 96px);
  font-weight:400;
  font-style:italic;
  color:#2d5a2a;            /* solid leafy green */
  letter-spacing:-0.025em;
  line-height:1.08;
  margin:0;
  word-break:normal;
  overflow-wrap:break-word;
  hyphens:none;
  max-width:100%;
}

.word{
  display:inline-block;
  white-space:nowrap;
  max-width:100%;
}

.char{
  display:inline-block;
  white-space:pre;
  opacity:0;
  will-change:transform,opacity;
  color:#2d5a2a;
}

.baseline{
  width:100%;
  height:2px;
  background:linear-gradient(90deg,var(--kale),var(--leaf),var(--lime),var(--spring),var(--cucumber));
  margin-top:clamp(10px, 2vw, 18px);
  opacity:0.7;
  border-radius:2px;
}

#replay{
  margin-top:clamp(14px, 3vw, 28px);
  padding:0;
  background:none;
  border:none;
  font-family:'DM Mono', monospace;
  font-size:clamp(10px, 1.3vw, 11px);
  font-weight:300;
  letter-spacing:0.12em;
  color:var(--leaf);
  cursor:pointer;
  text-transform:lowercase;
  transition:opacity 0.2s;
}
#replay:hover{opacity:0.6}

.hero p{
  max-width:650px;
  font-size:clamp(.92rem, 1.1vw, 1.05rem);
  margin:clamp(10px, 2vw, 16px) 0 0;
  color:var(--muted);
  line-height:1.6;
}

@media (max-width:400px){
  .text{font-size:clamp(22px, 7.5vw, 34px)}
  .hero{padding:18px 12px 14px}
  .hero-inner{padding:16px 14px 14px;border-radius:16px}
}

/* ---------- FILTERS ---------- */
.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;
  padding:clamp(16px, 3vw, 25px) clamp(16px, 5vw, 7%);
  background:linear-gradient(135deg, rgba(234,243,220,.95), rgba(200,230,160,.94) 50%, rgba(214,232,184,.95));
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  position:sticky;top:0;z-index:6;border-bottom:2px solid rgba(45,90,42,.35)}
label{font-size:.8rem;font-weight:800;margin-bottom:6px;display:block;color:var(--leaf);letter-spacing:.02em}
select,input{width:100%;padding:13px;border:2px solid rgba(45,90,42,.30);border-radius:12px;
  background:rgba(255,255,255,.96);color:var(--dark);font-weight:600;transition:border-color .2s,box-shadow .2s}
select:focus,input:focus{outline:none;border-color:var(--leaf);box-shadow:0 0 0 3px rgba(45,90,42,.20)}

main{padding:clamp(24px, 4vw, 35px) clamp(16px, 5vw, 7%)}
.directory-top{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;
  background:linear-gradient(135deg, rgba(250,253,242,.90), rgba(214,232,180,.85));
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
  padding:14px 20px;border-radius:20px;margin-bottom:6px;
  border:1px solid rgba(45,90,42,.25);
  box-shadow:0 6px 20px rgba(45,90,42,.12)}
.directory-top h2{color:var(--leaf);margin:0}
#count{color:var(--basil);font-weight:800}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(20px, 3vw, 30px);margin-top:25px}

/* ---------- CARDS (vegetable-green neumorphic) ---------- */
.card{width:100%;min-height:400px;border-radius:50px;overflow:hidden;display:flex;flex-direction:column;
  transition:transform .25s ease,box-shadow .25s ease}

/* Vegetable — fresh cucumber-lime */
.card.vegetable{background:linear-gradient(145deg,#eaf7cf,#c9eaa0);
  box-shadow:20px 20px 60px #b9cf98,-20px -20px 60px #ffffff}
.card.vegetable:hover{transform:translateY(-6px);box-shadow:24px 24px 70px #a9bf88,-24px -24px 70px #ffffff}

/* Fruit — soft leaf-sage (toned down for veg-page cohesion) */
.card.fruit{background:linear-gradient(145deg,#e2eece,#c3dba0);
  box-shadow:20px 20px 60px #b0c78e,-20px -20px 60px #ffffff}
.card.fruit:hover{transform:translateY(-6px);box-shadow:24px 24px 70px #a0b87e,-24px -24px 70px #ffffff}

/* Dairy — pale herbal cream-green */
.card.dairy{background:linear-gradient(145deg,#eef5dd,#d6e6b8);
  box-shadow:20px 20px 60px #bcd1a0,-20px -20px 60px #ffffff}
.card.dairy:hover{transform:translateY(-6px);box-shadow:24px 24px 70px #acc190,-24px -24px 70px #ffffff}

.thumb{height:175px;background:#c8d8b0;overflow:hidden;cursor:pointer;border-radius:50px 50px 0 0}
.thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease}
.card:hover .thumb img{transform:scale(1.06)}
.content{padding:22px 22px 28px;display:flex;flex-direction:column;flex:1}
.content h2{margin:13px 0 7px;font-size:1.25rem}
.card.vegetable .content h2{color:#2d5a2a}
.card.fruit .content h2{color:#3d6b1c}
.card.dairy .content h2{color:#5a7a3a}
.meta{color:#5a6b52;font-size:.9rem;font-weight:500}

.tag{display:inline-block;color:#fff;padding:6px 12px;border-radius:30px;
  font-size:.72rem;font-weight:800;letter-spacing:.06em;align-self:flex-start}
.card.vegetable .tag{background:linear-gradient(135deg,#8fbc4a,#2d5a2a);box-shadow:0 6px 14px rgba(45,90,42,.40)}
.card.fruit .tag{background:linear-gradient(135deg,#6b9b5a,#2d5a2a);box-shadow:0 6px 14px rgba(45,90,42,.35)}
.card.dairy .tag{background:linear-gradient(135deg,#a8d574,#6b9b5a);box-shadow:0 6px 14px rgba(107,155,90,.40)}

.details{display:inline-block;margin-top:auto;padding-top:15px;font-weight:800;text-decoration:none;
  background:none;border:0;font:inherit;font-weight:800;cursor:pointer;text-align:left}
.card.vegetable .details{color:var(--leaf)}
.card.fruit .details{color:var(--basil)}
.card.dairy .details{color:var(--herb)}
.details:hover{text-decoration:underline}

.empty{padding:35px;text-align:center;background:linear-gradient(145deg,#eaf7cf,#c9eaa0);
  border-radius:50px;box-shadow:20px 20px 60px #b9cf98,-20px -20px 60px #ffffff;color:var(--leaf);font-weight:700}

/* ---------- DETAIL MODAL ---------- */
.modal{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:20px}
.modal[hidden]{display:none}
.modal-backdrop{position:absolute;inset:0;
  background:linear-gradient(135deg, rgba(45,90,42,.55), rgba(107,155,90,.45));
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);animation:fadeIn .22s ease}
.modal-card{position:relative;width:100%;max-width:820px;max-height:92vh;overflow-y:auto;
  background:linear-gradient(180deg,#f9fcef 0%,#eef5dd 100%);
  border-radius:24px;box-shadow:0 30px 80px rgba(45,90,42,.40);
  border:2px solid rgba(45,90,42,.30);
  animation:slideUp .28s cubic-bezier(.2,.8,.3,1);overscroll-behavior:contain}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideUp{from{opacity:0;transform:translateY(24px) scale(.98)}to{opacity:1;transform:none}}
.modal-close{position:absolute;top:14px;right:14px;z-index:3;width:40px;height:40px;border-radius:50%;
  border:0;cursor:pointer;font-size:1.4rem;line-height:1;display:grid;place-items:center;
  background:linear-gradient(135deg,#2d5a2a,#6b9b5a);color:#fff;box-shadow:0 6px 16px rgba(45,90,42,.45)}
.modal-close:hover{background:linear-gradient(135deg,#1e4620,#4a7c3f)}
.modal-hero{height:250px;overflow:hidden;background:#c8d8b0}
.modal-hero img{width:100%;height:100%;object-fit:cover;display:block}
.modal-body{padding:28px 30px 34px}
.modal-body h2{margin:12px 0 6px;font-size:clamp(1.4rem,3.5vw,2rem);color:var(--leaf)}
.modal-body .lead{color:#3d4a35;margin:0 0 20px;font-weight:500}

.section-title{font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
  color:var(--basil);margin:26px 0 10px;
  display:flex;align-items:center;gap:8px}
.section-title::before{content:'';width:8px;height:8px;border-radius:50%;
  background:linear-gradient(135deg,var(--leaf),var(--lime))}
.section-title:first-of-type{margin-top:0}

.location-box{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start}
.location-info{display:flex;flex-direction:column;gap:12px}
.location-info .k{font-size:.72rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--basil)}
.location-info .v{margin-top:2px;font-size:.95rem;font-weight:600;color:var(--dark)}
.map-wrap{border-radius:16px;overflow:hidden;border:2px solid rgba(45,90,42,.30);background:#eef3e6;min-height:220px;
  box-shadow:0 6px 18px rgba(45,90,42,.18)}
.map-wrap iframe{width:100%;height:100%;min-height:220px;border:0;display:block}

.schedule-table{width:100%;border-collapse:separate;border-spacing:0;background:#f9fcef;
  border:2px solid rgba(45,90,42,.25);border-radius:16px;overflow:hidden}
.schedule-table th,.schedule-table td{padding:12px 16px;text-align:left;font-size:.9rem;
  border-bottom:1px solid rgba(45,90,42,.18)}
.schedule-table th{background:linear-gradient(135deg,#eaf3dc,#c8e6a0);color:var(--leaf);
  font-weight:800;font-size:.78rem;text-transform:uppercase;letter-spacing:.04em}
.schedule-table tr:last-child td{border-bottom:0}
.schedule-table td.day{font-weight:700;width:40%;color:var(--dark)}
.schedule-table td.hours{color:var(--muted)}
.schedule-table tr.closed td.hours{color:#a9b6a0;font-style:italic}
.schedule-table tr.closed td.day{color:#a9b6a0}
.schedule-table tr.open td.hours{color:var(--leaf);font-weight:700}
.schedule-table tr.open{background:linear-gradient(90deg, rgba(200,230,160,.55), rgba(246,249,239,.4))}
.schedule-table tr:nth-child(even).closed{background:rgba(234,243,220,.40)}

.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:12px;margin-bottom:22px}
.product-item{
  background:linear-gradient(145deg,#f9fcef,#eaf3dc);
  border:1px solid rgba(45,90,42,.25);border-radius:16px;padding:14px 8px;
  text-align:center;display:flex;flex-direction:column;align-items:center;gap:6px;
  transition:transform .15s ease,box-shadow .15s ease,background .15s ease}
.product-item:hover{transform:translateY(-3px);box-shadow:0 8px 18px rgba(45,90,42,.22);
  background:linear-gradient(145deg,#f6f9ef,#d4e8b8)}
.product-item .emoji{font-size:2rem;line-height:1}
.product-item .name{font-size:.78rem;font-weight:700;color:var(--dark);text-align:center}

.modal-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
.btn{border:0;cursor:pointer;font:inherit;font-weight:800;padding:13px 20px;border-radius:30px;
  text-decoration:none;display:inline-block;transition:transform .15s ease,box-shadow .15s ease,filter .15s ease}
.btn-primary{background:linear-gradient(135deg,var(--leaf),var(--herb));color:#fff;
  box-shadow:0 8px 20px rgba(45,90,42,.35)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(45,90,42,.45)}
.btn-ghost{background:linear-gradient(135deg,#eaf3dc,#c8e6a0);color:var(--leaf);
  border:1px solid rgba(45,90,42,.35)}
.btn-ghost:hover{background:linear-gradient(135deg,#d4e8b8,#a8d574);transform:translateY(-2px)}

#modalTag{color:#fff;padding:6px 12px;border-radius:30px;font-size:.72rem;font-weight:800;letter-spacing:.06em}
#modalTag.tag-vegetable{background:linear-gradient(135deg,#8fbc4a,#2d5a2a);box-shadow:0 6px 14px rgba(45,90,42,.35)}
#modalTag.tag-fruit{background:linear-gradient(135deg,#6b9b5a,#2d5a2a);box-shadow:0 6px 14px rgba(45,90,42,.35)}
#modalTag.tag-dairy{background:linear-gradient(135deg,#a8d574,#6b9b5a);box-shadow:0 6px 14px rgba(107,155,90,.35)}

@media(max-width:760px){
  .location-box{grid-template-columns:1fr}
  .grid{grid-template-columns:1fr}
}
@media(max-width:600px){
  main{padding-left:16px;padding-right:16px}
  .filters{padding:16px}
  .modal{padding:0}
  .modal-card{max-height:100vh;height:100%;border-radius:0}
  .modal-hero{height:200px}
  .modal-body{padding:22px}
  .product-grid{grid-template-columns:repeat(auto-fill,minmax(90px,1fr))}
}
</style>
<link rel="stylesheet" href="../styles.css">
</head>
<body>

<div class="video-bg" aria-hidden="true">
  <video id="bgVideo" autoplay muted loop playsinline preload="auto"
         poster="https://placehold.co/1920x1080/2d5a2a/ffffff?text=FreshFind">
    <source src="../vids/directory/veg.mp4" type="video/mp4" />
  </video>
</div>
<div class="video-overlay" aria-hidden="true"></div>

<section class="hero">
  <div class="hero-inner">
    <span class="label">spring physics</span>
    <h1 class="text">Vegetable Farm Market Directory</h1>
    <div class="baseline"></div>
    <button id="replay" type="button">↺ replay</button>
    <p>Discover local vegetable markets, leafy greens, herbs, and farm-fresh produce near you.</p>
  </div>
</section>

<section class="filters">
  <div><label for="area">Area / Neighborhood</label><select id="area"><option value="all">All areas</option></select></div>
  <div><label for="day">Operating day</label><select id="day"><option value="all">Any day</option><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option><option>Saturday</option><option>Sunday</option></select></div>
  <div><label for="produce">Produce type</label><select id="produce"><option value="all">All produce</option><option value="fruit">Fruit</option><option value="vegetable">Vegetable</option><option value="dairy">Dairy</option></select></div>
  <div><label for="sort">Sort by</label><select id="sort"><option value="alpha">Alphabetically</option><option value="proximity">Proximity</option><option value="next">Next open day</option></select></div>
</section>

<main>
  <div class="directory-top"><h2 id="heading">All Markets</h2><span id="count"></span></div>
  <div id="markets" class="grid"></div>
</main>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" hidden>
  <div class="modal-backdrop" data-close></div>
  <div class="modal-card">
    <button class="modal-close" type="button" data-close aria-label="Close market details">×</button>
    <div class="modal-hero"><img id="modalImg" src="" alt="" /></div>
    <div class="modal-body">
      <span class="tag" id="modalTag"></span>
      <h2 id="modalTitle"></h2>
      <p class="lead" id="modalDesc"></p>

      <p class="section-title">Location Details</p>
      <div class="location-box">
        <div class="location-info">
          <div><div class="k">Address</div><div class="v" id="modalAddress"></div></div>
          <div><div class="k">Area / Neighborhood</div><div class="v" id="modalArea"></div></div>
          <div><div class="k">Distance</div><div class="v" id="modalDistance"></div></div>
          <div><div class="k">Phone</div><div class="v" id="modalPhone"></div></div>
        </div>
        <div class="map-wrap">
          <iframe id="modalMapFrame" src="" loading="lazy" allowfullscreen
                  referrerpolicy="no-referrer-when-downgrade" title="Market location map"></iframe>
        </div>
      </div>

      <p class="section-title">Weekly Schedule</p>
      <table class="schedule-table" id="modalSchedule">
        <thead><tr><th>Day</th><th>Hours</th></tr></thead>
        <tbody></tbody>
      </table>

      <p class="section-title">Available Produce</p>
      <div class="product-grid" id="modalProductsGrid"></div>

      <div class="modal-actions">
        <a class="btn btn-primary" id="modalCall" href="#">📞 Call market</a>
        <a class="btn btn-ghost" id="modalMap" href="#" target="_blank" rel="noopener">📍 Get directions</a>
        <button class="btn btn-ghost" type="button" data-close>Close</button>
      </div>
    </div>
  </div>
</div>

<script>
/* ================================================================
   SPRING PHYSICS HEADING — word-wrapped, replayable
   ================================================================ */
const TEXT = document.querySelector('.text');
const BTN  = document.getElementById('replay');

function split(el) {
  const raw = el.textContent;
  el.textContent = '';
  const chars = [];
  const tokens = raw.split(/(\s+)/);

  tokens.forEach(token => {
    if (!token) return;
    if (/^\s+$/.test(token)) {
      for (const ch of token) {
        const s = document.createElement('span');
        s.className = 'char';
        s.textContent = ch;
        el.appendChild(s);
        chars.push(s);
      }
    } else {
      const word = document.createElement('span');
      word.className = 'word';
      for (const ch of token) {
        const s = document.createElement('span');
        s.className = 'char';
        s.textContent = ch;
        word.appendChild(s);
        chars.push(s);
      }
      el.appendChild(word);
    }
  });
  return chars;
}

function run(fn){ fn(); BTN.onclick = fn; }

function spring(s, target, k = 0.08, d = 0.72) {
  s.vel += (target - s.pos) * k;
  s.vel *= d;
  s.pos += s.vel;
  return Math.abs(s.vel) + Math.abs(target - s.pos) < 0.05;
}

let _raf = null, _cleanup = () => {};
function loop(onTick, cleanup = () => {}) {
  cancelAnimationFrame(_raf);
  _cleanup(); _cleanup = cleanup;
  function tick() { if (!onTick()) _raf = requestAnimationFrame(tick); }
  _raf = requestAnimationFrame(tick);
}

function center_burst() {
  const chars = split(TEXT);
  const textRect = TEXT.getBoundingClientRect();
  const cx = textRect.left + textRect.width / 2;
  const offsets = chars.map(ch => {
    const r = ch.getBoundingClientRect();
    return (r.left + r.width / 2) - cx;
  });
  const xst = chars.map((_, i) => ({ pos: -offsets[i], vel: 0 }));
  const yst = chars.map(() => ({ pos: (Math.random() - 0.5) * 40, vel: 0 }));
  const ops = chars.map(() => ({ pos: 0, vel: 0 }));
  loop(() => chars.every((ch, i) => {
    const xd = spring(xst[i], 0, 0.07, 0.70);
    const yd = spring(yst[i], 0, 0.09, 0.68);
    spring(ops[i], 1, 0.08, 0.74);
    ch.style.transform = `translate(${xst[i].pos}px, ${yst[i].pos}px)`;
    ch.style.opacity   = ops[i].pos;
    return xd && yd;
  }));
}

run(center_burst);

/* ================================================================
   MARKET DIRECTORY DATA
   ================================================================ */
const markets=[
{id:1,name:'Orchard Lane Fruit Market',area:'Clifton',days:['Friday','Saturday','Sunday'],hours:'8:00 AM – 5:00 PM',type:'fruit',distance:2.4,emoji:'🍎',image:'https://placehold.co/600x400/2d5a2a/ffffff?text=Orchard+Lane',description:'Seasonal fruit, citrus, berries, and orchard-fresh harvests.',
